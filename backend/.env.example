# ------ Server ------
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/websyner?retryWrites=true&w=majority

# ------ Auth ------
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Seeded super admin (npm run seed)
SUPER_ADMIN_EMAIL=admin@websyner.co
SUPER_ADMIN_PASSWORD=admin12345

# ------ Cloudinary (media uploads) ------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------ SMTP (nodemailer) ------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="WebSyner <hello@websyner.co>"

# ------ App origins ------
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Shared secret with the Next.js on-demand revalidation webhook
REVALIDATE_SECRET=change-me-revalidate-secret

# Company timezone for attendance / cron
COMPANY_TZ=Asia/Dhaka
